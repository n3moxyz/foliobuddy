# Frontend Environment Variables

# Backend API URL
# Local (requires Docker + backend): http://localhost:4001/api/v1
# Remote backend (optional): use a backend you control; keep production allowlist notes private.
VITE_API_URL=http://localhost:4001/api/v1

# WebSocket Backend URL
# Local dev: http://localhost:4001
# Remote backend: match VITE_API_URL's host.
VITE_WS_BACKEND_URL=http://localhost:4001

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key

# Local QA only: renders authenticated app routes without Clerk when paired with the backend
# ALLOW_LOCAL_AUTH_BYPASS=true setting. Ignored in production builds because it requires DEV.
VITE_LOCAL_AUTH_BYPASS=false

# Sentry Error Tracking (optional - leave empty to disable)
VITE_SENTRY_DSN=
