# Frontend Environment Variables

# Backend API URL (leave empty for local dev - Vite proxy handles it)
# For production: Vercel rewrites /api/* to Railway, so this is not needed
# VITE_API_URL=https://empowering-curiosity-production-9eff.up.railway.app/api

# WebSocket Backend URL (for production, Vercel doesn't proxy WebSockets)
# Falls back to hardcoded Railway URL if omitted
VITE_WS_BACKEND_URL=https://empowering-curiosity-production-9eff.up.railway.app

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Sentry Error Tracking (optional - leave empty to disable)
VITE_SENTRY_DSN=
