generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - supports multi-user if needed
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String?
  // Daily snapshot preference: local hour (0-23) in an IANA timezone.
  // Defaults preserve the original global 5am Asia/Singapore schedule.
  snapshotHour     Int               @default(5)
  snapshotTimezone String            @default("Asia/Singapore")
  // Null means this legacy local-only preference has not yet been synced by any device.
  perpExposureUsd  Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  positions        Position[]
  positionHistory  PositionHistory[]
  trades           Trade[]
  investors        Investor[]
  snapshots        Snapshot[]
  ibkrSyncRuns     IbkrSyncRun[]
  ibkrSyncDevices  IbkrSyncDevice[]
}

// Asset model - represents any tradeable asset
// category: LIQUID_CRYPTO | STABLECOIN | NFT | ANGEL | CASH
model Asset {
  id              String            @id @default(cuid())
  coingeckoId     String?           @unique
  priceProvider   String            @default("coingecko")
  providerAssetId String?
  nativeCurrency  String            @default("USD")
  exchange        String?
  factsheetUrl    String?
  // Registrable domain of the issuer/protocol's official site (e.g. "nvidia.com").
  // News from this domain earns the Primary source badge for this asset.
  officialDomain  String?
  isin            String?
  symbol          String
  name            String
  category        String            @default("LIQUID_CRYPTO")
  currentPriceUsd Float?
  priceUpdatedAt  DateTime?
  // Unit-trust quote currency is authoritative; USD is revalued when FX changes.
  currentPriceNative Float?
  priceAsOf       DateTime?
  priceSource     String?
  priceCheckedAt  DateTime?
  priceCheckStatus String?
  priceFxRateToUsd Float?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  positions       Position[]
  positionHistory PositionHistory[]
  trades          Trade[]
  priceHistory    PriceHistory[]

  @@unique([priceProvider, providerAssetId])
  @@index([symbol])
  @@index([coingeckoId])
}

// Price history for tracking asset prices over time
model PriceHistory {
  id             String   @id @default(cuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  priceUsd       Float
  nativePrice    Float?
  nativeCurrency String?
  fxRateToUsd    Float?
  source         String   @default("coingecko")
  updatedBy      String?
  timestamp      DateTime @default(now())

  @@unique([assetId, timestamp, source])
  @@index([assetId, timestamp])
}

// Position model - represents a holding of an asset
// storageType: WALLET | CEX | DEFI | BANK
model Position {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity        Float
  avgCostUsd      Float    @default(0)
  // Optional authoritative weighted average in the purchase currency. The USD
  // column remains the recorded ledger; API reads project native basis at current FX.
  avgCostNative   Float?
  costCurrency    String?
  // IBKR-only reconciliation metadata; ordinary cash remains a single currency.
  ibkrContractId  Int?
  ibkrSyncedAt    DateTime?
  ibkrCash        Json?
  storageType     String   @default("WALLET")
  storageLocation String?
  notes           String?
  custodyOf       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Computed fields (stored for performance)
  marketValueUsd   Float?
  unrealizedPnL    Float?
  unrealizedPnLPct Float?
  history          PositionHistory[]
  ibkrSyncDevices  IbkrSyncDevice[]

  @@index([userId])
  @@index([assetId])
  @@index([custodyOf])
  @@unique([userId, ibkrContractId])
}

// Private source receipts and reversible financial-state checkpoints.
// These are reconciliations, never inferred transaction fills.
model IbkrSyncRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  captureHash String
  kind        String
  source      Json
  before      Json
  after       Json
  restoredAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, captureHash])
  @@index([userId, createdAt])
}

// A revocable, owner-enrolled public key. It grants only complete IBKR syncs for
// one existing cash anchor; private keys remain on the enrolled Mac.
model IbkrSyncDevice {
  id                    String   @id
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashPositionId        String
  cashPosition          Position @relation(fields: [cashPositionId], references: [id], onDelete: Cascade)
  // Nullable unique value is cleared by revocation, never reassigned.
  activeCashPositionId  String?  @unique
  name                  String
  publicKey             String
  keyFingerprint        String   @unique
  connectorFingerprint  String
  audience              String
  createdAt             DateTime @default(now())
  revokedAt             DateTime?
  lastSeenAt            DateTime?
  lastVerifiedAt        DateTime?
  lastCapturedAt        DateTime?
  lastStatus            String   @default("authorized")
  lastError             String?
  lastChanges           Json?
  nonces                IbkrSyncDeviceNonce[]
  attempts              IbkrSyncAttempt[]

  @@index([userId, cashPositionId, createdAt])
}

model IbkrSyncDeviceNonce {
  deviceId  String
  device    IbkrSyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([deviceId, nonce])
  @@index([expiresAt])
}

// A continuity guard for a previously approved connector, not broker ownership
// attestation. No cascading relation: revoke, anchor removal or owner deletion
// must never make the same connector claimable by a different account.
model IbkrConnectorBinding {
  connectorFingerprint String   @id
  // Null means conflicting legacy grants; only an explicit owner review can resolve it.
  userId               String?
  createdAt            DateTime @default(now())

  @@index([userId])
}

// A short-lived browser-approved capability. Only the SHA-256 token digest is
// persisted; its scope remains immutable and consumption is transactional.
model IbkrHelperPermit {
  tokenHash            String   @id
  userId               String
  cashPositionId       String
  connectorFingerprint String
  challenge            String
  operation            String
  jobId                String?
  createdAt            DateTime @default(now())
  expiresAt            DateTime
  consumedAt           DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Financial source/checkpoint material remains private. Unfinished or uncertain
// attempts retain the unique anchor claim even after the device is revoked.
model IbkrSyncAttempt {
  id                   String   @id @default(cuid())
  deviceId             String
  device               IbkrSyncDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  activeCashPositionId String?  @unique
  status               String   @default("previewed")
  capture              Json
  // Preserve exact reviewed numeric bytes; Prisma JSON decoding can round a ULP.
  captureText          String?
  state                String
  backup               Json
  backupText           String?
  checkpointHash       String
  runId                String?
  readbackHash         String?
  unchanged            Boolean
  capturedAt           DateTime
  errorStage           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([deviceId, createdAt])
}

// PositionHistory - add/reduce activity for aggregate holdings
// mode: add | reduce
model PositionHistory {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId           String
  position             Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assetId              String
  asset                Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  mode                 String
  quantity             Float
  costBasisUsd         Float
  previousQuantity     Float
  previousAvgCostUsd   Float
  previousTotalCostUsd Float
  nextQuantity         Float
  nextAvgCostUsd       Float
  nextTotalCostUsd     Float
  proceedsUsd          Float?
  costCurrency         String?
  costBasisNative      Float?
  previousAvgCostNative Float?
  nextAvgCostNative     Float?
  proceedsNative       Float?
  fxRateToUsd          Float?
  executionPriceNative Float?
  feesNative           Float?
  brokerOrderId        String?
  operationId          String?
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([positionId, createdAt])
  @@index([assetId])
  @@index([operationId])
}

// Trade model - represents a single trade
// direction: LONG | SHORT
// status: OPEN | CLOSED
model Trade {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  direction       String    @default("LONG")
  entryPrice      Float
  exitPrice       Float?
  quantity        Float
  positionSizeUsd Float
  entryDate       DateTime
  exitDate        DateTime?
  fundingCost     Float     @default(0)
  realizedPnL     Float?
  realizedPnLPct  Float?
  status          String    @default("OPEN")
  notes           String?
  tags            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([assetId])
  @@index([status])
  @@index([entryDate])
  @@index([exitDate])
}

// Investor model - for tracking external investors/stakeholders
model Investor {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  stakePercentage Float           @default(0)
  initialCapital  Float           @default(0)
  currentValue    Float?
  totalReturn     Float?
  totalReturnPct  Float?
  joinDate        DateTime        @default(now())
  notes           String?
  isOwner         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  stakes          InvestorStake[]

  @@index([userId])
}

// InvestorStake - tracks stake changes over time
model InvestorStake {
  id              String   @id @default(cuid())
  investorId      String
  investor        Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  stakePercentage Float
  valueAtTime     Float
  timestamp       DateTime @default(now())

  @@index([investorId, timestamp])
}

// Snapshot model - for tracking portfolio value over time
// snapshotType: DAILY | WEEKLY | MONTHLY
// source: AUTOMATIC | MANUAL
model Snapshot {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp          DateTime           @default(now())
  snapshotType       String             @default("DAILY")
  scheduledLocalDate String? // YYYY-MM-DD; scheduler idempotency key component
  source             String             @default("AUTOMATIC")
  totalValueUsd      Float
  totalValueSgd      Float?
  usdSgdRate         Float?
  totalCostBasis     Float?
  unrealizedPnL      Float?
  realizedPnL        Float?
  dailyReturn        Float?
  weeklyReturn       Float?
  monthlyReturn      Float?
  ytdReturn          Float?
  athValueUsd        Float?
  btcPrice           Float?
  ethPrice           Float?
  btcOutperform      Float?
  ethOutperform      Float?
  notes              String?
  positions          SnapshotPosition[]

  @@unique([userId, snapshotType, scheduledLocalDate])
  @@index([userId, timestamp])
  @@index([snapshotType])
  @@index([userId, snapshotType, timestamp])
}

// SnapshotPosition - captures position state at snapshot time
model SnapshotPosition {
  id          String   @id @default(cuid())
  snapshotId  String
  snapshot    Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  // Tickers repeat across asset classes (USDE: Ethena stablecoin + StablecoinX
  // equity), so the label lookup needs the asset id. Null on rows written before
  // it existed. No relation on purpose: snapshot history outlives catalog deletes.
  assetId     String?
  assetSymbol String
  quantity    Float
  priceUsd    Float
  valueUsd    Float
  allocation  Float

  @@index([snapshotId])
}

// FX Rate model - for currency conversion
model FxRate {
  id        String   @id @default(cuid())
  fromCcy   String
  toCcy     String
  rate      Float
  timestamp DateTime @default(now())

  @@unique([fromCcy, toCcy])
  @@index([fromCcy, toCcy])
}

// Settings model - for app configuration
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Posts from the private X source roster (X_NEWS_SOURCES), collected every 15
// minutes for the News tab. Portfolio-independent: holdings are matched when
// the feed is read, so collection never reveals what anyone holds. Pruned
// after 60 days (the holding page's window).
model XPost {
  id              String   @id // X status id
  authorHandle    String
  // Lower-cased handle: X handles are case-insensitive, the roster may differ in case.
  authorKey       String
  text            String
  quotedPostId    String?
  quotedHandle    String?
  quotedText      String?
  // Links a non-X page — the "source-backed" signal for conditional roster roles.
  hasExternalLink Boolean  @default(false)
  cashtags        String[]
  lang            String?
  postedAt        DateTime
  collectedAt     DateTime @default(now())

  @@index([postedAt])
  @@index([authorKey, postedAt])
}
