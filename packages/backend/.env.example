# Backend Environment Variables

# Server
PORT=4001
# Local development default. Set NODE_ENV=production only in the deployed backend environment.
NODE_ENV=development

# Database (local Postgres via Docker — run: npm run db:local)
DATABASE_URL=postgresql://dev:dev@localhost:5433/example_portfolio_db

# Optional production DB mirror source for private maintainer workflows.
# Never commit a real production connection string.
PRODUCTION_DATABASE_URL=postgresql://user:password@db.example.internal:5432/foliobuddy

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=https://foliobuddy.xyz,http://localhost:4000

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_secret_key

# Local QA only: lets the local backend use LOCAL_AUTH_USER_ID when Clerk has no user.
# Ignored in NODE_ENV=production. Keep false outside local synthetic-data testing.
ALLOW_LOCAL_AUTH_BYPASS=false
LOCAL_AUTH_USER_ID=local-scale-user

# Admin-only global asset catalog edits (comma-separated Clerk user IDs)
ADMIN_USER_IDS=replace_with_clerk_user_id

# Agent API (OpenClaw bot access — bypasses Clerk auth)
AGENT_API_KEY=your-32-char-hex-key-here
AGENT_USER_ID=replace_with_clerk_user_id

# Sentry (optional — error tracking, skipped if empty)
SENTRY_DSN=

# News enrichment (optional — AI summaries for Top stories via the Claude API).
# Leave ANTHROPIC_API_KEY empty to disable enrichment entirely; /news works
# unchanged without it. Model override is optional.
ANTHROPIC_API_KEY=
NEWS_ENRICHMENT_MODEL=claude-opus-5
