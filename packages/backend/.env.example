# Backend Environment Variables

# Server
PORT=4001
NODE_ENV=production

# Database (PostgreSQL - self-hosted on DigitalOcean/Coolify)
DATABASE_URL=postgresql://pa_user:password@your-droplet-ip:5432/example_portfolio_db

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=https://pa-port.vercel.app,http://localhost:4000

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
