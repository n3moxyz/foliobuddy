# Backend Environment Variables

# Server
PORT=4001
NODE_ENV=production

# Database (local Postgres via Docker — run: npm run db:local)
DATABASE_URL=postgresql://dev:dev@localhost:5433/pa_portfolio

# Production DB (used by npm run db:sync to pull production data locally)
PRODUCTION_DATABASE_URL=postgresql://user:pass@178.128.88.81:5432/dbname

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=https://foliobuddy.xyz,https://pa-port.vercel.app,http://localhost:4000

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Sentry (optional — error tracking, skipped if empty)
SENTRY_DSN=
