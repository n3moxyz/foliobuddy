{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/frontend && npm run build",
  "outputDirectory": "packages/frontend/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "alias": ["foliobuddy.xyz"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pa-port.vercel.app" }],
      "destination": "https://foliobuddy.xyz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pa-port-n3mos-projects.vercel.app" }],
      "destination": "https://foliobuddy.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.foliobuddy.xyz/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
